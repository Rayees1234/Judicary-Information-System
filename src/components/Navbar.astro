---
import { getCurrentUser } from '../lib/auth';

const user = getCurrentUser(Astro.request);
const pathname = Astro.url.pathname;
---

<header class="navbar">
  <div class="container-wide nav-container">
    <div class="nav-brand">
      <a href="/" class="brand-link">
        <svg class="court-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
          <line x1="2" y1="9" x2="22" y2="9"/>
        </svg>
        <span class="brand-title">JIS</span>
        <span class="brand-subtitle">Judiciary Information System</span>
      </a>
    </div>

    <nav class="nav-links">
      <a href="/" class:list={['nav-item', { active: pathname === '/' }]}>Home</a>
      {user && (
        <a href="/dashboard" class:list={['nav-item', { active: pathname === '/dashboard' }]}>Dashboard</a>
      )}
      <a href="/cases" class:list={['nav-item', { active: pathname.startsWith('/cases') }]}>Cases</a>
      <a href="/causelist" class:list={['nav-item', { active: pathname.startsWith('/causelist') }]}>Cause List</a>
      <a href="/hearings" class:list={['nav-item', { active: pathname.startsWith('/hearings') }]}>Hearings</a>
      
      {user && ['ADMIN', 'JUDGE', 'CLERK'].includes(user.role) && (
        <a href="/reports" class:list={['nav-item', { active: pathname.startsWith('/reports') }]}>Reports</a>
      )}

      {user && user.role === 'ADMIN' && (
        <a href="/admin/users" class:list={['nav-item', { active: pathname.startsWith('/admin') }]}>Admin Panel</a>
      )}
    </nav>

    <div class="nav-actions">
      {user ? (
        <div class="user-menu">
          <a href="/notifications" class="notif-btn" title="Notifications">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </a>
          <div class="user-badge">
            <span class="user-name">{user.full_name}</span>
            <span class="user-role role-tag">{user.role}</span>
          </div>
          <form method="POST" action="/api/auth/logout" style="display:inline;">
            <button type="submit" class="btn btn-outline btn-sm">Sign Out</button>
          </form>
        </div>
      ) : (
        <div class="auth-buttons">
          <a href="/login" class="btn btn-primary btn-sm">Sign In</a>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .navbar {
    background-color: var(--bg-cream);
    border-bottom: 1px solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.75rem 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-charcoal);
  }

  .court-icon {
    color: var(--text-charcoal);
  }

  .brand-title {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .brand-subtitle {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    border-left: 1px solid var(--border-interactive);
    padding-left: 0.6rem;
    margin-left: 0.2rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-item {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .nav-item:hover, .nav-item.active {
    color: var(--text-charcoal);
    background-color: rgba(28, 28, 28, 0.04);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .notif-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--border-light);
    color: var(--text-charcoal);
    text-decoration: none;
    background: var(--bg-surface);
  }

  .user-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  .user-name {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .role-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .brand-subtitle {
      display: none;
    }
    .nav-links {
      display: none;
    }
  }
</style>
