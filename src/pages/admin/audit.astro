---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCurrentUser } from '../../lib/auth';
import { getAllAuditLogs } from '../../lib/services/auditService';

const user = getCurrentUser(Astro.request);
if (!user || user.role !== 'ADMIN') {
  return Astro.redirect('/login');
}

const logs = getAllAuditLogs(100, 0);
---

<BaseLayout title="System Audit Trail — JIS Administration">
  <Navbar />

  <main class="container-wide main-content">
    <div class="breadcrumbs">
      <a href="/">Home</a> &rsaquo; <a href="/admin/users">Admin Panel</a> &rsaquo; <span>Audit Logs</span>
    </div>

    <div class="page-header">
      <div>
        <h1 class="page-title">Immutable System Audit Trail</h1>
        <p class="page-desc">Tamper-evident record of all judicial case transactions, filings, adjournments, judgments, and security events.</p>
      </div>

      <div class="header-actions">
        <span class="badge badge-registered">ISO 29148 / OWASP Compliant</span>
      </div>
    </div>

    <div class="table-wrapper">
      <table class="table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Event Action</th>
            <th>Related Case</th>
            <th>Actor / User</th>
            <th>Details & Event Payload</th>
            <th>Client IP</th>
          </tr>
        </thead>
        <tbody>
          {logs.map(log => (
            <tr>
              <td style="font-size: 0.8125rem; font-family: var(--font-mono); white-space: nowrap;">
                {log.created_at}
              </td>
              <td>
                <span class="action-tag">{log.action}</span>
              </td>
              <td>
                {log.case_cin ? (
                  <a href={`/cases/${log.case_cin}`} class="cin-tag">{log.case_cin}</a>
                ) : (
                  <span style="color: var(--text-muted); font-size: 0.75rem;">System</span>
                )}
              </td>
              <td>
                <div style="font-weight: 600; font-size: 0.875rem;">{log.user_name || 'System Auto'}</div>
                <div style="font-size: 0.75rem; color: var(--text-secondary);">{log.user_role || 'SERVER'}</div>
              </td>
              <td style="font-size: 0.8125rem; max-width: 400px; line-height: 1.4;">
                {log.details}
              </td>
              <td style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-secondary);">
                {log.ip_address}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    padding: 2.5rem 0 4rem;
  }

  .breadcrumbs {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
  }

  .page-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .action-tag {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: #f1f5f9;
    color: #1e293b;
    border: 1px solid #cbd5e1;
  }
</style>
