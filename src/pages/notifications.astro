---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCurrentUser } from '../lib/auth';
import { getUserNotifications } from '../lib/services/notificationService';

const user = getCurrentUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

const notifications = getUserNotifications(user.id, 50);
---

<BaseLayout title="My Notifications — JIS">
  <Navbar />

  <main class="container main-content">
    <div class="breadcrumbs">
      <a href="/">Home</a> &rsaquo; <span>Notifications</span>
    </div>

    <div class="page-header">
      <div>
        <h1 class="page-title">Judicial Notifications & Alerts</h1>
        <p class="page-desc">Real-time SMS and Email alerts regarding listed matters, hearings, and orders.</p>
      </div>
    </div>

    {notifications.length > 0 ? (
      <div class="notifications-list">
        {notifications.map(n => (
          <div class:list={['card notif-card', { 'unread': !n.is_read }]}>
            <div class="notif-top">
              <span class:list={['badge', n.channel === 'SMS' ? 'badge-adjourned' : 'badge-hearing']}>
                {n.channel} Dispatch
              </span>
              <span class="notif-time">{n.created_at}</span>
            </div>

            <div class="notif-type">{n.notification_type.replace(/_/g, ' ')}</div>
            <p class="notif-message">{n.message}</p>

            <div class="notif-actions">
              {!n.is_read && (
                <button class="btn btn-outline btn-sm" onclick={`markRead(${n.id})`}>
                  Mark as Read
                </button>
              )}
              {n.case_id && (
                <a href={`/cases`} class="btn btn-primary btn-sm">
                  View Case
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="card empty-card">
        <svg viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1.5" fill="none" style="margin: 0 auto 1rem; color: var(--text-secondary);">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <h3>No Notifications</h3>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">You have no unread judicial alerts or hearing updates.</p>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  async function markRead(id) {
    try {
      const res = await fetch('/api/notifications', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      if (res.ok) {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
    }
  }
</script>

<style>
  .main-content {
    padding: 2.5rem 0 4rem;
    max-width: 800px;
  }

  .breadcrumbs {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
  }

  .page-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .notifications-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .notif-card {
    background: #ffffff;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--border-light);
  }

  .notif-card.unread {
    border-left-color: #3b82f6;
    background: #fafaf9;
  }

  .notif-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .notif-time {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .notif-type {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-charcoal);
    margin-bottom: 0.25rem;
  }

  .notif-message {
    font-size: 0.9375rem;
    color: var(--text-charcoal);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .notif-actions {
    display: flex;
    gap: 0.5rem;
  }

  .empty-card {
    text-align: center;
    padding: 3rem;
    background: #ffffff;
  }
</style>
