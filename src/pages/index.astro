---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getDb } from '../lib/db/index';
import { getCauseList } from '../lib/services/hearingService';
import { getCurrentUser } from '../lib/auth';

const user = getCurrentUser(Astro.request);
const db = getDb();

// Quick statistics
const stats = {
  totalCases: (db.prepare('SELECT COUNT(*) as c FROM cases').get() as any).c,
  scheduledHearings: (db.prepare("SELECT COUNT(*) as c FROM hearings WHERE status = 'SCHEDULED'").get() as any).c,
  adjournedCases: (db.prepare("SELECT COUNT(*) as c FROM cases WHERE status = 'ADJOURNED'").get() as any).c,
  disposedCases: (db.prepare("SELECT COUNT(*) as c FROM cases WHERE status IN ('DISPOSED', 'SETTLED', 'WITHDRAWN', 'CLOSED')").get() as any).c,
};

// Today's cause list preview
const today = new Date().toISOString().split('T')[0];
const todayHearings = getCauseList(today).slice(0, 5);
---

<BaseLayout title="Judiciary Information System (JIS) — Official Court Portal">
  <Navbar />

  <main>
    <!-- Hero Section with Search -->
    <section class="hero-section">
      <div class="container hero-content">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          National e-Courts Mission Mode &bull; NJDG Standard Verified
        </div>
        <h1 class="hero-title">Judiciary Information System</h1>
        <p class="hero-subtitle">
          End-to-end case tracking, automated CIN allocation, judicial cause lists, signed judgment archives, and transparent public access.
        </p>

        <!-- Search Box -->
        <div class="search-box card">
          <form action="/cases" method="GET" class="search-form">
            <div class="search-input-wrap">
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input 
                type="text" 
                name="q" 
                placeholder="Search by CIN (e.g. DL-HC-CIV-2026-0001), Party Name, or Advocate..." 
                class="search-input"
                required
              />
            </div>
            <button type="submit" class="btn btn-primary search-btn">
              Search Cases
            </button>
          </form>
          <div class="quick-tags">
            <span class="quick-label">Try searching:</span>
            <a href="/cases?q=DL-HC-CIV-2026-0001" class="tag-link">DL-HC-CIV-2026-0001</a>
            <a href="/cases?q=Ramesh Sharma" class="tag-link">Ramesh Sharma</a>
            <a href="/cases?type=WRIT_PETITION" class="tag-link">Writ Petitions</a>
            <a href="/causelist" class="tag-link">Today's Cause List</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <section class="stats-section">
      <div class="container stats-grid">
        <div class="stat-card">
          <div class="stat-number">{stats.totalCases}</div>
          <div class="stat-label">Cases on File</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{stats.scheduledHearings}</div>
          <div class="stat-label">Upcoming Hearings</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{stats.adjournedCases}</div>
          <div class="stat-label">Adjourned Matters</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{stats.disposedCases}</div>
          <div class="stat-label">Cases Disposed</div>
        </div>
      </div>
    </section>

    <!-- Today's Cause List Preview & Portals -->
    <section class="content-section">
      <div class="container section-layout">
        <!-- Left: Today's Hearings Preview -->
        <div class="main-column">
          <div class="section-header">
            <div>
              <h2 class="section-title">Today's Cause List</h2>
              <p class="section-subtitle">Court proceedings scheduled for {today}</p>
            </div>
            <a href="/causelist" class="btn btn-outline btn-sm">View Full Cause List &rarr;</a>
          </div>

          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th>Time & Court</th>
                  <th>CIN</th>
                  <th>Matter / Parties</th>
                  <th>Presiding Judge</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {todayHearings.length > 0 ? (
                  todayHearings.map(h => (
                    <tr>
                      <td>
                        <strong>{h.hearing_date.split(' ')[1] || '10:30'}</strong>
                        <div style="font-size: 0.75rem; color: var(--text-secondary);">{h.courtroom}</div>
                      </td>
                      <td>
                        <a href={`/cases/${h.case_cin}`} class="cin-tag">{h.case_cin}</a>
                      </td>
                      <td>
                        <div style="font-weight: 600;">{h.case_title}</div>
                        <div style="font-size: 0.8125rem; color: var(--text-secondary);">
                          {h.petitioner_name} vs {h.respondent_name}
                        </div>
                      </td>
                      <td>{h.judge_name || 'Designated Bench'}</td>
                      <td>
                        <StatusBadge status={h.status} />
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-secondary);">
                      No hearings listed on today's cause list.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right: Role Portals -->
        <div class="side-column">
          <div class="card portal-card">
            <h3 class="portal-card-title">System Role Portals</h3>
            <p class="portal-card-desc">Select your designated interface or sign in with your role-based credentials:</p>

            <div class="portal-links">
              <a href="/cases/new" class="portal-item">
                <div class="portal-icon">&#128221;</div>
                <div>
                  <div class="portal-name">Registry & Clerk</div>
                  <div class="portal-hint">Register case, verify documents, generate CIN</div>
                </div>
              </a>

              <a href="/causelist" class="portal-item">
                <div class="portal-icon">&#9878;</div>
                <div>
                  <div class="portal-name">Hon'ble Bench / Judge</div>
                  <div class="portal-hint">Hearing calendar, record proceedings & judgments</div>
                </div>
              </a>

              <a href="/cases" class="portal-item">
                <div class="portal-icon">&#128188;</div>
                <div>
                  <div class="portal-name">Advocate & Counsel</div>
                  <div class="portal-hint">Assigned cases, hearing dates, download orders</div>
                </div>
              </a>

              <a href="/reports" class="portal-item">
                <div class="portal-icon">&#128202;</div>
                <div>
                  <div class="portal-name">Court Administration</div>
                  <div class="portal-hint">Disposal rates, pendency aging, judge workload</div>
                </div>
              </a>
            </div>

            <div class="login-prompt">
              {user ? (
                <div style="font-size: 0.875rem; text-align: center;">
                  Signed in as <strong>{user.full_name}</strong> ({user.role})
                </div>
              ) : (
                <a href="/login" class="btn btn-primary" style="width: 100%;">
                  Sign In with Role Account
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-section {
    padding: 4rem 0 3rem;
    text-align: center;
    background: radial-gradient(circle at 50% 20%, rgba(28, 28, 28, 0.03) 0%, transparent 60%);
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 4px 12px;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .search-box {
    text-align: left;
    background: #ffffff;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .search-form {
    display: flex;
    gap: 0.75rem;
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border-interactive);
    border-radius: 6px;
    padding: 0 1rem;
    color: var(--text-secondary);
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 12px 0;
    font-size: 1rem;
    color: var(--text-charcoal);
    font-family: inherit;
  }

  .search-input:focus {
    outline: none;
  }

  .search-btn {
    padding: 0 1.5rem;
    font-size: 1rem;
  }

  .quick-tags {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
  }

  .quick-label {
    color: var(--text-secondary);
  }

  .tag-link {
    background: var(--bg-cream);
    padding: 2px 8px;
    border-radius: 4px;
    text-decoration: none;
    color: var(--text-charcoal);
    border: 1px solid var(--border-light);
  }

  .tag-link:hover {
    background: #eceae4;
  }

  .stats-section {
    padding: 2rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    background: #ffffff;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stat-number {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-charcoal);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .content-section {
    padding: 3rem 0;
  }

  .section-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .section-subtitle {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .portal-card {
    background: #ffffff;
  }

  .portal-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .portal-card-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .portal-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .portal-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-charcoal);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .portal-item:hover {
    background: var(--bg-cream);
    border-color: var(--border-interactive);
  }

  .portal-icon {
    font-size: 1.25rem;
  }

  .portal-name {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .portal-hint {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .login-prompt {
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 900px) {
    .section-layout {
      grid-template-columns: 1fr;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .hero-title {
      font-size: 2rem;
    }
    .search-form {
      flex-direction: column;
    }
  }
</style>
